# =============================================================================
# UCSNotificationCenter - example configuration
#
#   1. Copy this file to a new file called  .env  (same folder as main.py)
#   2. Replace every <placeholder> with your own value
#   3. NEVER commit your real .env - it holds secret tokens (it is git-ignored)
#
# Rules for this file
#   - One  NAME=value  per line, no spaces around "=", no quotes needed.
#   - Lines starting with # are comments.
#   - Variable names are spelled EXACTLY as the code expects them (even the odd
#     ones, like KFC_WOERGL_CHATID vs KFC_DP_CHAT_ID). Do not "fix" them.
#   - A variable marked "may be empty" must still be present as a bare "NAME=".
#     If it is missing entirely the bot misbehaves (for example it would ping
#     "@alex_ucs @None" when an employee has no second Telegram account).
#
# Full explanation of every variable: docs/configuration.md
# =============================================================================


# -----------------------------------------------------------------------------
# 1. MAIN BOT  ("UCS Support Bot")
#    The bot that talks to YOUR team: it posts summaries in the internal team
#    group and asks engineers for error/resolution codes in private chat.
#    Get a token from @BotFather in Telegram (see docs/getting-started.md).
# -----------------------------------------------------------------------------
UCS_Support_Bot_TELEGRAM_API_TOKEN=<token of the main bot>
UCS_AUSTRIA_CHAT_ID=<chat id of the internal team group, e.g. -1001234567890>


# -----------------------------------------------------------------------------
# 2. TEST MODE   (python main.py --test)
#    Test mode uses ONE pretend restaurant group and a separate pair of bots, so
#    you can experiment without touching real restaurants.
#    NOTE: in test mode the pretend restaurant's bot is the one whose token is
#    UCS_Support_Bot_TELEGRAM_API_TOKEN (section 1), and the "main bot" role is
#    played by the TEST_UCS_SUPPORT_Bot token below. So test mode needs two
#    different bot tokens in total.
# -----------------------------------------------------------------------------
TEST_UCS_SUPPORT_Bot_TELEGRAM_API_TOKEN=<token of the TEST main bot>
TEST_UCS_SUPPORT_CHAT_ID=<chat id of the test internal group>
TEST_CHAT_ID=<chat id of the pretend-restaurant group>


# -----------------------------------------------------------------------------
# 3. THE SUPPORT TEAM
#    The ORDER of EMPLOYEEn_NAME is the escalation order (the person who is
#    "supporting today" according to the Google Sheet is moved to the front).
#
#    !! The list MUST end with one EMPTY entry (EMPLOYEE6_NAME= below). The code
#    !! reads EMPLOYEE1_NAME, EMPLOYEE2_NAME, ... until it finds an empty one.
#    !! Without the empty line it will invent "None" employees.
#
#    For every employee NAME you list, these four variables must exist
#    (NAME is written in CAPITAL letters in the variable name):
#       <NAME>_TELEGRAM_USERNAME          Telegram @username WITHOUT the @,
#                                         spelled exactly as Telegram shows it
#       <NAME>_SECOND_TELEGRAM_USERNAME   optional 2nd account - leave EMPTY if none
#       <NAME>_TELEGRAM_ID                numeric id of their private chat with the
#                                         main bot (get it by sending /my_id to it)
#       <NAME>_MAINCELLPHONE_NUMBER       international format, e.g. +436601234567
#                                         (only needed for phone calls)
#
#    !! Keep Alex, Egor, Vova, Ivan and Igor defined, even if some are not on your
#    !! team (leave their values empty). The chat commands /pending and
#    !! /killyourself decide "is this a team member?" using exactly these five
#    !! names - see docs/troubleshooting.md, "Known limitations".
# -----------------------------------------------------------------------------
EMPLOYEE1_NAME=Alex
EMPLOYEE2_NAME=Egor
EMPLOYEE3_NAME=Vova
EMPLOYEE4_NAME=Ivan
EMPLOYEE5_NAME=Igor
EMPLOYEE6_NAME=

ALEX_TELEGRAM_USERNAME=<telegram_username>
ALEX_SECOND_TELEGRAM_USERNAME=
ALEX_TELEGRAM_ID=<number>
ALEX_MAINCELLPHONE_NUMBER=<+4366...>

EGOR_TELEGRAM_USERNAME=<telegram_username>
EGOR_SECOND_TELEGRAM_USERNAME=
EGOR_TELEGRAM_ID=<number>
EGOR_MAINCELLPHONE_NUMBER=<+4366...>

VOVA_TELEGRAM_USERNAME=<telegram_username>
VOVA_SECOND_TELEGRAM_USERNAME=
VOVA_TELEGRAM_ID=<number>
VOVA_MAINCELLPHONE_NUMBER=<+4366...>

IVAN_TELEGRAM_USERNAME=<telegram_username>
IVAN_SECOND_TELEGRAM_USERNAME=
IVAN_TELEGRAM_ID=<number>
IVAN_MAINCELLPHONE_NUMBER=<+4366...>

IGOR_TELEGRAM_USERNAME=<telegram_username>
IGOR_SECOND_TELEGRAM_USERNAME=
IGOR_TELEGRAM_ID=<number>
IGOR_MAINCELLPHONE_NUMBER=<+4366...>


# -----------------------------------------------------------------------------
# 4. GOOGLE SHEETS
#    The names are the TITLES you see in Google Sheets (case-sensitive):
#    the spreadsheet file, and two tabs inside it. Also needs service_account.json
#    in the project folder - see docs/getting-started.md.
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_NAME=<title of the spreadsheet file>
GOOGLE_SHEETS_SUPPORT_WORKSHEET_NAME=<tab with the daily support schedule>
GOOGLE_SHEETS_SUPPORTDATA_WORKSHEET_NAME=<tab where finished tickets are logged>


# -----------------------------------------------------------------------------
# 5. RESTAURANT CHANNELS  (production; not needed for --test)
#    One Telegram group + one bot per restaurant. To add a restaurant, see
#    "Adding a restaurant" in docs/configuration.md.
# -----------------------------------------------------------------------------

# KFC WOERGL  (language/country code: de)
KFC_WOERGL_CHATID=<chat id>
UCS_Support_Woergl_Bot_TELEGRAM_API_TOKEN=<token>

# KFC MIL  (language/country code: de)
KFC_MIL_CHATID=<chat id>
